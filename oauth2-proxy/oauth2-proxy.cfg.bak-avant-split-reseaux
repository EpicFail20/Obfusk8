# Configuration oauth2-proxy - LAB (Keycloak) -> identique en prod avec Entra ID
# en changeant uniquement oidc_issuer_url / client_id / client_secret.

provider = "oidc"
oidc_issuer_url = "http://keycloak.lab.local:8080/realms/lab"
redirect_url = "https://anonymiseur.lab.local/oauth2/callback"

client_id = "${OAUTH2_PROXY_CLIENT_ID}"
# client_secret et cookie_secret sont fournis via Docker secrets
# (OAUTH2_PROXY_CLIENT_SECRET_FILE / OAUTH2_PROXY_COOKIE_SECRET_FILE dans
# docker-compose.yml) — ne pas les remettre ici en clair.
#
# Note générale sur ce fichier : oauth2-proxy (legacy .cfg) ne fait PAS
# d'interpolation ${VAR} — la ligne client_id ci-dessus est donc littérale
# et sans effet ; c'est la variable d'env OAUTH2_PROXY_CLIENT_ID (définie
# dans .env, priorité plus forte) qui fournit la vraie valeur. Fonctionnel
# tel quel, mais garde-le en tête si tu modifies un jour cette ligne en
# pensant qu'elle sert à quelque chose.

email_domains = ["*"]
cookie_secure = true
cookie_httponly = true
cookie_expire = "1h"

# Groupe imitant le futur groupe Entra "SG-Anonymiseur-Utilisateurs"
allowed_groups = ["/SG-Anonymiseur-Utilisateurs"]

pass_access_token = false
pass_user_headers = true
set_xauthrequest = true

http_address = "0.0.0.0:4180"
reverse_proxy = true
