# ==============================================================================
# Fichier de configuration — copiez-le en ".env" avant de le remplir.
#
#   cp .env.example .env
#
# Ne committez JAMAIS le fichier ".env" réel (il est exclu par .gitignore).
# Toutes les valeurs ci-dessous sont des exemples ou des valeurs par défaut
# sûres — remplacez-les par les vôtres avant le premier démarrage.
# ==============================================================================


# ------------------------------------------------------------------------------
# Domaine et authentification (OBLIGATOIRE)
# ------------------------------------------------------------------------------

# Domaine (ou sous-domaine) sur lequel l'application sera accessible.
APP_DOMAIN=anonymiseur.exemple.local

# Identifiant du client OIDC, tel que créé dans votre fournisseur d'identité
# (Keycloak, Entra ID, Okta...).
OAUTH2_PROXY_CLIENT_ID=anonymiseur-app

# Secret du client OIDC, généré par votre fournisseur d'identité au moment
# de la création du client. Ne jamais mettre de vraie valeur ici — copiez
# ce fichier en .env et remplissez UNIQUEMENT le .env, jamais ce template.
OAUTH2_PROXY_CLIENT_SECRET=<a-recuperer-apres-creation-du-client-oidc>

# Clé aléatoire utilisée pour signer/chiffrer les cookies de session.
# Générer avec : openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=<generer-une-cle-aleatoire-openssl-rand--base64-32>


# ------------------------------------------------------------------------------
# Plafonds anti-abus — bornent la taille/volume des documents traités.
# Les valeurs par défaut ci-dessous sont volontairement prudentes ; ne les
# augmentez qu'en connaissance de cause (voir SECURITE.md).
# ------------------------------------------------------------------------------

# Taille maximale d'un fichier uploadé, en mégaoctets.
MAX_UPLOAD_MB=25

# Taille maximale du corps de requête HTTP accepté par l'application,
# en octets — première ligne de défense avant même le parsing du fichier.
MAX_REQUEST_BODY_BYTES=26214400

# Nombre de tâches (documents en cours de traitement/révision) pouvant être
# en attente simultanément avant que de nouvelles soumissions soient refusées.
MAX_PENDING_JOBS=20

# Nombre maximal de pages acceptées pour un document PDF.
MAX_PDF_PAGES=70

# Nombre maximal de paragraphes acceptés pour un document DOCX.
MAX_DOCX_PARAGRAPHS=5000

# Nombre maximal de cellules acceptées pour un fichier CSV (lignes × colonnes).
MAX_CSV_CELLS=5000

# Nombre maximal d'entrées acceptées dans l'archive ZIP interne d'un DOCX
# (protection contre les "zip bombs" par nombre d'entrées, distincte du
# ratio de compression ci-dessous).
MAX_DOCX_ZIP_ENTRIES=5000

# Taille totale maximale (décompressée) acceptée pour l'archive ZIP interne
# d'un DOCX, en mégaoctets.
MAX_DOCX_UNCOMPRESSED_MB=200

# Ratio de compression maximal toléré par entrée du ZIP interne d'un DOCX
# (protection contre les "zip bombs" classiques par ratio).
MAX_DOCX_ZIP_RATIO=100

# Nombre de pixels maximal (largeur × hauteur) toléré pour une image
# incrustée dans un PDF avant son rendu — protection contre les images aux
# dimensions falsifiées.
MAX_IMAGE_PIXELS=40000000

# Durée maximale, en secondes, allouée à la détection sur un même document
# avant interruption propre — protège le service (mono-worker) contre un
# document qui monopoliserait le traitement pour tout le monde.
MAX_DETECTION_SECONDS=90

# Durée maximale, en secondes, allouée à l'étape OCR sur une image.
MAX_OCR_SECONDS=60

# Nombre maximal de lignes affichées sur l'écran de révision (CSV/DOCX).
# Le caviardage réel, lui, couvre toujours l'intégralité du document —
# cette limite ne borne que ce qui est affiché à l'écran, pas ce qui est
# traité.
MAX_REVIEW_ROWS=2000

# Nombre maximal de zones de caviardage manuel qu'un utilisateur peut
# ajouter sur un document (fonctionnalité disponible pour le PDF).
MAX_MANUAL_ZONES=50

# Nombre maximal d'identifiants qu'un utilisateur peut explicitement
# exclure de la détection sur un même document.
MAX_EXCLUDED_IDS=50


# ------------------------------------------------------------------------------
# Scan antivirus (optionnel) — nécessite un serveur ICAP déjà déployé dans
# votre infrastructure. Désactivé par défaut : aucun changement de
# comportement tant que AV_ENGINE reste à "none".
# ------------------------------------------------------------------------------

# Moteur de scan antivirus : "none" (désactivé) ou "icap".
AV_ENGINE=none

# Si "true", un fichier jugé infecté OU un moteur antivirus injoignable
# bloque le traitement (comportement "fail-closed" recommandé). Si "false",
# le document est traité malgré tout en cas d'indisponibilité du moteur.
AV_ENFORCE=true

# Adresse du serveur ICAP (uniquement si AV_ENGINE=icap).
ICAP_HOST=

# Port du serveur ICAP.
ICAP_PORT=1344

# Délai d'attente, en secondes, avant de considérer le serveur ICAP
# injoignable.
ICAP_TIMEOUT_SECONDS=10


# ------------------------------------------------------------------------------
# Supervision et alerting (optionnel) — nécessite un collecteur syslog/SIEM
# déjà déployé dans votre infrastructure. Désactivé par défaut.
# Les métriques Prometheus, elles, sont toujours exposées sur /metrics
# (aucune donnée personnelle n'y figure).
# ------------------------------------------------------------------------------

# Destination des alertes : "none" (journalisation locale uniquement) ou
# "syslog".
ALERT_SINK=none

# Adresse du collecteur syslog (uniquement si ALERT_SINK=syslog).
SYSLOG_HOST=
