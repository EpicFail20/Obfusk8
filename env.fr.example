# Copiez en ".env" et remplissez après avoir créé le client dans Keycloak.

APP_DOMAIN=anonymiseur.lab.local

# BIND_ADDRESS : seule adresse de l'hôte sur laquelle Traefik (80, 443) et
# Keycloak (8080) sont publiés ; jamais toutes les interfaces (EXT-56).
# 127.0.0.1 par défaut (sûr : accès depuis la VM seulement). Pour un accès
# depuis d'autres postes, mettez l'adresse de la VM sur le réseau local
# (par exemple 192.168.1.35).
BIND_ADDRESS=127.0.0.1

# UI_LANG : langue de l'interface. Valeurs acceptées = les fichiers de
# langue présents dans app/i18n/ (actuellement "fr", "en") ; toute autre
# valeur revient au français par défaut, avec un avertissement affiché
# au démarrage (voir docs/traduire-interface.md).
UI_LANG=fr

# --- Réglages ajustables de `app` (plafonds anti-abus) ---
# Toutes les variables ci-dessous sont câblées dans le bloc
# `environment:` du service `app` de docker-compose.yml via
# ${VAR:-valeur_par_défaut} ; les modifier ici prend effet au prochain
# `docker compose up -d app`.

# MAX_UPLOAD_MB : taille maximale (Mo) d'un fichier uploadé.
MAX_UPLOAD_MB=25
# FILE_TTL_SECONDS : durée pendant laquelle un fichier uploadé et ses
# artefacts dérivés restent sur disque avant purge automatique.
FILE_TTL_SECONDS=180
# JOB_REVIEW_TTL_SECONDS : durée pendant laquelle une tâche de détection
# reste disponible pour révision manuelle avant purge automatique.
JOB_REVIEW_TTL_SECONDS=600
# MAX_PDF_PAGES : nombre maximal de pages acceptées dans un PDF uploadé.
MAX_PDF_PAGES=70
# MAX_DOCX_PARAGRAPHS : nombre maximal de paragraphes acceptés dans un
# DOCX uploadé.
MAX_DOCX_PARAGRAPHS=5000
# MAX_DOCX_UNCOMPRESSED_MB : taille décompressée maximale (Mo) acceptée
# lors de l'extraction d'un DOCX (protection zip-bomb).
MAX_DOCX_UNCOMPRESSED_MB=200
# MAX_DOCX_ZIP_RATIO : ratio de compression maximal accepté pour les
# entrées de l'archive interne d'un DOCX (protection zip-bomb).
MAX_DOCX_ZIP_RATIO=100
# MAX_CSV_ROWS : nombre maximal de lignes acceptées dans un CSV uploadé.
MAX_CSV_ROWS=20000
# MAX_CSV_CELLS : nombre total maximal de cellules acceptées dans un CSV
# uploadé.
MAX_CSV_CELLS=5000
# MAX_CSV_FIELD_CHARS : longueur maximale (caractères) acceptée pour un
# seul champ CSV.
MAX_CSV_FIELD_CHARS=100000
# MAX_PENDING_JOBS_PER_USER : nombre maximal de documents en attente de
# révision par utilisateur (EXT-51). Au-delà : 429 avec Retry-After ; le
# plafond commun (MAX_PENDING_JOBS, 20) reste en dernier rempart. 0 désactive
# le quota (déconseillé : un seul utilisateur peut alors bloquer tous les autres).
MAX_PENDING_JOBS_PER_USER=3
# ENABLE_JOB_CANCEL : bouton « Annuler ce document » de la page de révision,
# qui libère aussitôt la place du document dans le quota.
ENABLE_JOB_CANCEL=true

# --- API texte pour l'extension de navigateur (docs/api-extension.md) ---
# ENABLE_EXTENSION_API : true pour activer les routes /api/v1/ (analyse et
# pseudonymisation de prompts). false (défaut) : routes absentes (404),
# flux documents strictement inchangé.
ENABLE_EXTENSION_API=false
# EXTENSION_ALLOWED_ORIGINS : origines des extensions autorisées sur /api/v1/,
# séparées par des virgules, au format chrome-extension://<identifiant de
# 32 lettres a-p>. Vide (défaut) : toute analyse est refusée (403). Une entrée
# mal formée empêche le démarrage. Exemple (identifiant fictif) :
# EXTENSION_ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
EXTENSION_ALLOWED_ORIGINS=
# MAX_TEXT_CHARS : taille maximale d'un texte, en caractères. Si vous la
# changez, recalculez le label Traefik text-bodylimit dans
# docker-compose.yml : 12 × MAX_TEXT_CHARS + 4096 octets.
MAX_TEXT_CHARS=20000
# MAX_TEXT_ANALYSIS_SECONDS : délai maximal d'une requête de texte (attente
# comprise), en secondes.
MAX_TEXT_ANALYSIS_SECONDS=10
# MAX_TEXT_CONCURRENCY : analyses de texte simultanées (1 recommandé :
# l'analyseur n'a qu'un worker, partagé avec le flux documents).
MAX_TEXT_CONCURRENCY=1
# MAX_TEXT_QUEUE : requêtes de texte autorisées à attendre ; au-delà, 429.
MAX_TEXT_QUEUE=8

# --- Réglages sensibles côté sécurité (documentation uniquement) ---
# Les variables ci-dessous sont bien lues par le code (app/main.py,
# app/antivirus.py, app/supervision.py) mais volontairement NON câblées
# à une substitution .env dans docker-compose.yml — un choix délibéré,
# pas un oubli : tout changement de seuil de détection ou de posture
# antivirus/alerting doit passer par une modification relue de
# docker-compose.yml lui-même, pas par un changement silencieux de
# .env. Voir les commentaires en regard de chacune dans
# docker-compose.yml pour la justification complète avant d'en changer
# une.
# DEFAULT_SCORE_THRESHOLD (sensibilité de détection, flux "Aucun thème"
# uniquement) :
DEFAULT_SCORE_THRESHOLD=0.4
# AV_ENGINE, AV_ENFORCE, ICAP_HOST, ICAP_PORT, ICAP_SERVICE,
# ICAP_TIMEOUT_SECONDS, ICAP_TLS (scan antivirus, voir app/antivirus.py) :
AV_ENGINE=none
AV_ENFORCE=true
ICAP_HOST=
ICAP_PORT=1344
ICAP_SERVICE=avscan
ICAP_TIMEOUT_SECONDS=30
ICAP_TLS=false
# ALERT_SINK, SYSLOG_HOST, SYSLOG_PORT, SYSLOG_TCP (alerting
# opérationnel, voir app/supervision.py) :
ALERT_SINK=none
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_TCP=false

OAUTH2_PROXY_CLIENT_ID=anonymiseur-app

# ⚠️ Le client secret OIDC et le cookie secret NE PASSENT PAS par ce
# fichier — ils sont gérés comme des Docker secrets, générés par
# ./generate-secrets.sh dans ./secrets/ (jamais commités, jamais en clair
# ici). N'AJOUTEZ JAMAIS de ligne OAUTH2_PROXY_CLIENT_SECRET= ou
# OAUTH2_PROXY_COOKIE_SECRET= dans .env, même temporairement : si l'une
# de ces deux variables existe dans .env, oauth2-proxy lui donne la
# priorité sur le Docker secret correspondant (voir docker-compose.yml,
# env_file: .env sur oauth2-proxy) et échoue au démarrage avec une
# erreur qui n'a l'air de venir de nulle part
# (`cookie_secret must be 16, 24, or 32 bytes... but is 51 bytes` — 51
# étant la longueur d'un texte placeholder, pas celle d'un vrai secret).
# Vécu deux fois en lab sur ce projet — voir le guide de déploiement.
