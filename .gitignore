# Secrets — ne jamais versionner
.env

# Fichiers générés par Docker / l'application (pas du code source)
__pycache__/
*.pyc
.pytest_cache/

# Données Keycloak (volume Docker, pas du code)
keycloak-data/

# Certificats Traefik générés dynamiquement (si présents en local)
traefik/certs/*.pem
traefik/certs/*.key

# Éditeurs
.vscode/
*.swp
# --- Secrets : ne jamais commiter ---
secrets/
.env
*.env
!.env.example

# --- Jamais de document réel dans le dépôt (audit, section 11ter.7) ---
# Un compte-rendu de laboratoire réel a été versionné par mégarde puis purgé
# de l'historique. Seuls les fixtures FICTIFS de app/tests/fixtures/ sont
# autorisés ; tout autre document est ignoré par défaut.
*.pdf
*.docx
*.csv
*.png
*.jpg
*.jpeg
!app/tests/fixtures/**

# --- Secret passerelle Traefik (audit 3.7) : rendu par generate-secrets.sh,
#     contient le secret en clair, ne jamais versionner ---
traefik/dynamic/gateway-secret.yml
