# Secrets — never commit
.env

# Files generated by Docker / the application (not source code)
__pycache__/
*.pyc
.pytest_cache/

# Keycloak data (Docker volume, not code)
keycloak-data/

# Traefik certificates generated dynamically (if present locally)
traefik/certs/*.pem
traefik/certs/*.key

# Editors
.vscode/
*.swp
# --- Secrets: never commit ---
secrets/
.env
*.env
!.env.example

# --- Never a real document in the repo (audit, section 11ter.7) ---
# A real lab report was accidentally committed and then purged
# from history. Only the FICTITIOUS fixtures in app/tests/fixtures/ are
# allowed; any other document is ignored by default.
*.pdf
*.docx
*.csv
*.png
*.jpg
*.jpeg
!app/tests/fixtures/**

# --- Traefik gateway secret (audit 3.7): rendered by generate-secrets.sh,
#     contains the secret in clear text, never commit ---
traefik/dynamic/gateway-secret.yml
