{
  "score_threshold": 0.4,
  "allow_list": ["Positive", "Conclusion", "Dossier", "Veuillez", "Sexe", "Enregistré", "Enr", "Laboratoire"],
  "excluded_entity_types": ["ORGANIZATION"],
  "ad_hoc_recognizers": [
    {
      "name": "PatientDossierNumberRecognizer",
      "supported_language": "fr",
      "patterns": [
        {
          "name": "dossier patient (lettre + chiffres)",
          "regex": "\\b[A-Z]\\d{8,12}\\b",
          "score": 0.6
        },
        {
          "name": "dossier patient (chiffres + lettre + chiffres, ex: 22D0755084)",
          "regex": "\\b\\d{1,4}[A-Z]\\d{6,10}\\b",
          "score": 0.6
        }
      ],
      "context": ["dossier", "numero", "numéro", "patient", "identifiant"],
      "supported_entity": "PATIENT_ID"
    },
    {
      "name": "FrenchNirRecognizer",
      "supported_language": "fr",
      "patterns": [
        {
          "name": "NIR / numéro de sécurité sociale",
          "regex": "\\b[12]\\s?\\d{2}\\s?(0[1-9]|1[0-2])\\s?(\\d{2}|2[AB])\\s?\\d{3}\\s?\\d{3}\\s?\\d{2}\\b",
          "score": 0.7
        }
      ],
      "context": ["nir", "securite sociale", "sécurité sociale", "assure", "assuré"],
      "supported_entity": "FR_NIR"
    },
    {
      "name": "PatientIdentifierRecognizer",
      "supported_language": "fr",
      "patterns": [
        {
          "name": "IEP (zéro(s) en tête + 8 chiffres min)",
          "regex": "\\b(?:IEP|iep|Iep)\\s{0,2}[:.\\-]?\\s{0,2}0\\d{7,}\\b",
          "score": 0.7
        },
        {
          "name": "IPP (zéro(s) en tête + 8 chiffres min)",
          "regex": "\\b(?:IPP|ipp|Ipp)\\s{0,2}[:.\\-]?\\s{0,2}0\\d{7,}\\b",
          "score": 0.7
        }
      ],
      "context": ["iep", "ipp"],
      "supported_entity": "PATIENT_ID"
    },
