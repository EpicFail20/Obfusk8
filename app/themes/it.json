{
  "score_threshold": 0.4,
  "allow_list": [
    "^10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$",
    "^172\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$",
    "^192\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
  ],
  "allow_list_match": "regex",
  "ad_hoc_recognizers": [
    {
      "name": "PrivateIpSuffixRecognizer",
      "supported_language": "fr",
      "patterns": [
        {
          "name": "suffixe IP privée (10.x.x.x)",
          "regex": "(?<=\\b10\\.)\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}\\b",
          "score": 0.75
        },
        {
          "name": "suffixe IP privée (172.x.x.x)",
          "regex": "(?<=\\b172\\.)\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}\\b",
          "score": 0.75
        },
        {
          "name": "suffixe IP privée (192.x.x.x)",
          "regex": "(?<=\\b192\\.)\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}\\b",
          "score": 0.75
        }
      ],
      "context": ["ip", "adresse", "serveur", "reseau", "réseau"],
      "supported_entity": "PRIVATE_IP_SUFFIX"
    },
    {
      "name": "GenericApiKeyRecognizer",
      "supported_language": "fr",
      "patterns": [
        {
          "name": "clé API générique (préfixe + chaîne)",
          "regex": "\\b(?:sk|pk|key|token|api)[-_][A-Za-z0-9]{16,64}\\b",
          "score": 0.6
        }
      ],
      "context": ["api", "key", "token", "cle", "clé"],
      "supported_entity": "API_KEY"
    },
    {
      "name": "AwsAccessKeyRecognizer",
      "supported_language": "fr",
      "patterns": [
        {
          "name": "AWS Access Key ID",
          "regex": "\\bAKIA[0-9A-Z]{16}\\b",
          "score": 0.85
        }
      ],
      "context": ["aws", "access key"],
      "supported_entity": "AWS_ACCESS_KEY"
    },
    {
      "name": "InternalHostnameRecognizer",
      "supported_language": "fr",
      "patterns": [
        {
          "name": "hostname interne (.local, .internal, .lan)",
          "regex": "\\b[a-zA-Z0-9-]+\\.(?:local|internal|lan|corp)\\b",
          "score": 0.5
        }
      ],
      "context": ["serveur", "hostname", "machine"],
      "supported_entity": "INTERNAL_HOSTNAME"
    },
    {
      "name": "SshPrivateKeyHeaderRecognizer",
      "supported_language": "fr",
      "patterns": [
        {
          "name": "en-tête clé privée SSH/PEM",
          "regex": "-----BEGIN (?:RSA |OPENSSH |EC )?PRIVATE KEY-----",
          "score": 0.9
        }
      ],
      "context": [],
      "supported_entity": "PRIVATE_KEY"
    },
    {
      "name": "ShellPromptUserHostRecognizer",
      "supported_language": "fr",
      "patterns": [
        {
          "name": "prompt shell utilisateur@hostname (suivi de : $ # >)",
          "regex": "\\b[\\w-]{1,32}@[\\w-]{1,64}(?=[:$#>])",
          "score": 0.6
        }
      ],
      "context": ["ssh", "shell", "terminal", "prompt", "root"],
      "supported_entity": "SHELL_USER_HOST"
    }
  ]
}
