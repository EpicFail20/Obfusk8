# ==============================================================================
# Configuration file — copy it to ".env" before filling it in.
#
#   cp .env.example .env
#
# NEVER commit the real ".env" file (it is excluded via .gitignore).
# All values below are examples or safe defaults — replace them with your
# own before the first startup.
# ==============================================================================


# ------------------------------------------------------------------------------
# Domain and authentication (REQUIRED)
# ------------------------------------------------------------------------------

# Domain (or subdomain) on which the application will be accessible.
APP_DOMAIN=anonymizer.example.local

# UI_LANG: interface language. Accepted values = the language files
# present in app/i18n/ (currently "fr", "en"); any other value falls back
# to French with a warning logged at startup. Reference/default value only:
# like the other `app` tunables (MAX_UPLOAD_MB...), this is NOT read from
# .env by docker-compose — change it directly in the `environment:` block
# of the `app` service in docker-compose.yml (see docs/traduire-interface.md).
UI_LANG=fr

# OIDC client ID, as created in your identity provider
# (Keycloak, Entra ID, Okta...).
OAUTH2_PROXY_CLIENT_ID=anonymizer-app

# OIDC client secret, generated by your identity provider when the
# client is created. Never put a real value here — copy this file to
# .env and fill in ONLY the .env file, never this template.
OAUTH2_PROXY_CLIENT_SECRET=<retrieve-after-creating-the-oidc-client>

# Random key used to sign/encrypt session cookies.
# Generate with: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=<generate-a-random-key-openssl-rand--base64-32>


# ------------------------------------------------------------------------------
# Anti-abuse caps — bound the size/volume of processed documents.
# The default values below are deliberately conservative; only increase
# them knowingly (see SECURITY.md).
# ------------------------------------------------------------------------------

# Maximum size of an uploaded file, in megabytes.
MAX_UPLOAD_MB=25

# Maximum HTTP request body size accepted by the application, in bytes —
# the first line of defense, even before the file is parsed.
MAX_REQUEST_BODY_BYTES=26214400

# Number of jobs (documents being processed/reviewed) allowed to be
# pending at the same time before new submissions are rejected.
MAX_PENDING_JOBS=20

# Maximum number of pages accepted for a PDF document.
MAX_PDF_PAGES=70

# Maximum number of paragraphs accepted for a DOCX document.
MAX_DOCX_PARAGRAPHS=5000

# Maximum number of cells accepted for a CSV file (rows × columns).
MAX_CSV_CELLS=5000

# Maximum number of entries accepted in a DOCX file's internal ZIP
# archive (protection against "zip bombs" by entry count, distinct
# from the compression ratio below).
MAX_DOCX_ZIP_ENTRIES=5000

# Maximum total (decompressed) size accepted for a DOCX file's internal
# ZIP archive, in megabytes.
MAX_DOCX_UNCOMPRESSED_MB=200

# Maximum compression ratio tolerated per entry of a DOCX file's
# internal ZIP archive (protection against classic ratio-based
# "zip bombs").
MAX_DOCX_ZIP_RATIO=100

# Maximum number of pixels (width × height) tolerated for an image
# embedded in a PDF before it is rendered — protection against images
# with falsified dimensions.
MAX_IMAGE_PIXELS=40000000

# Maximum duration, in seconds, allotted to detection on a single
# document before a clean interruption — protects the (single-worker)
# service against a document that would monopolize processing for
# everyone else.
MAX_DETECTION_SECONDS=90

# Maximum duration, in seconds, allotted to the OCR step on an image.
MAX_OCR_SECONDS=60

# Maximum number of rows displayed on the review screen (CSV/DOCX).
# The actual redaction always covers the entire document — this limit
# only bounds what is displayed on screen, not what is processed.
MAX_REVIEW_ROWS=2000

# Maximum number of manual redaction zones a user can add to a
# document (feature available for PDF).
MAX_MANUAL_ZONES=50

# Maximum number of identifiers a user can explicitly exclude from
# detection on a single document.
MAX_EXCLUDED_IDS=50


# ------------------------------------------------------------------------------
# Antivirus scanning (optional) — requires an ICAP server already
# deployed in your infrastructure. Disabled by default: no change in
# behavior as long as AV_ENGINE stays "none".
# ------------------------------------------------------------------------------

# Antivirus scanning engine: "none" (disabled) or "icap".
AV_ENGINE=none

# If "true", a file deemed infected OR an unreachable antivirus engine
# blocks processing (recommended "fail-closed" behavior). If "false",
# the document is processed anyway if the engine is unavailable.
AV_ENFORCE=true

# ICAP server address (only if AV_ENGINE=icap).
ICAP_HOST=

# ICAP server port.
ICAP_PORT=1344

# Timeout, in seconds, before considering the ICAP server unreachable.
ICAP_TIMEOUT_SECONDS=10


# ------------------------------------------------------------------------------
# Monitoring and alerting (optional) — requires a syslog/SIEM collector
# already deployed in your infrastructure. Disabled by default.
# Prometheus metrics, on the other hand, are always exposed on /metrics
# (no personal data appears there).
# ------------------------------------------------------------------------------

# Alert destination: "none" (local logging only) or "syslog".
ALERT_SINK=none

# Syslog collector address (only if ALERT_SINK=syslog).
SYSLOG_HOST=
