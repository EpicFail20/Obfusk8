# Copy to ".env" and fill in after creating the client in Keycloak.

APP_DOMAIN=anonymiseur.lab.local

# UI_LANG: interface language. Accepted values = the language files
# present in app/i18n/ (currently "fr", "en"); any other value falls back
# to French with a warning logged at startup (see docs/traduire-interface.md).
UI_LANG=fr

# --- `app` tunables (anti-abuse limits) ---
# All of these are wired into the `environment:` block of the `app`
# service in docker-compose.yml as ${VAR:-default}; changing them here
# takes effect on the next `docker compose up -d app`.

# MAX_UPLOAD_MB: maximum size (MB) of an uploaded file.
MAX_UPLOAD_MB=25
# FILE_TTL_SECONDS: how long an uploaded file and its derived artifacts
# are kept on disk before automatic purge.
FILE_TTL_SECONDS=180
# JOB_REVIEW_TTL_SECONDS: how long a detection job stays available for
# manual review before automatic purge.
JOB_REVIEW_TTL_SECONDS=600
# MAX_PDF_PAGES: maximum number of pages accepted in an uploaded PDF.
MAX_PDF_PAGES=70
# MAX_DOCX_PARAGRAPHS: maximum number of paragraphs accepted in an
# uploaded DOCX.
MAX_DOCX_PARAGRAPHS=5000
# MAX_DOCX_UNCOMPRESSED_MB: maximum uncompressed size (MB) accepted when
# unpacking a DOCX (zip-bomb guard).
MAX_DOCX_UNCOMPRESSED_MB=200
# MAX_DOCX_ZIP_RATIO: maximum compression ratio accepted for a DOCX's
# internal zip entries (zip-bomb guard).
MAX_DOCX_ZIP_RATIO=100
# MAX_CSV_ROWS: maximum number of rows accepted in an uploaded CSV.
MAX_CSV_ROWS=20000
# MAX_CSV_CELLS: maximum total number of cells accepted in an uploaded CSV.
MAX_CSV_CELLS=5000
# MAX_CSV_FIELD_CHARS: maximum length (characters) accepted for a single
# CSV field.
MAX_CSV_FIELD_CHARS=100000

# --- Security-sensitive settings (documentation only) ---
# The variables below are read by the code (app/main.py, app/antivirus.py,
# app/supervision.py) but are intentionally NOT wired to .env substitution
# in docker-compose.yml — this is a deliberate choice, not an oversight:
# any change to a detection threshold or to the antivirus/alerting posture
# must go through a reviewed edit of docker-compose.yml itself, not a
# silent .env change. See the comments next to each in docker-compose.yml
# for the full rationale before ever changing one.
# DEFAULT_SCORE_THRESHOLD (detection sensitivity, "No theme" flow only):
DEFAULT_SCORE_THRESHOLD=0.4
# AV_ENGINE, AV_ENFORCE, ICAP_HOST, ICAP_PORT, ICAP_SERVICE,
# ICAP_TIMEOUT_SECONDS, ICAP_TLS (antivirus scan, see app/antivirus.py):
AV_ENGINE=none
AV_ENFORCE=true
ICAP_HOST=
ICAP_PORT=1344
ICAP_SERVICE=avscan
ICAP_TIMEOUT_SECONDS=30
ICAP_TLS=false
# ALERT_SINK, SYSLOG_HOST, SYSLOG_PORT, SYSLOG_TCP (operational alerting,
# see app/supervision.py):
ALERT_SINK=none
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_TCP=false

OAUTH2_PROXY_CLIENT_ID=anonymiseur-app

# ⚠️ The OIDC client secret and the cookie secret do NOT go through this
# file — they're managed as Docker secrets, generated by
# ./generate-secrets.sh into ./secrets/ (never committed, never in plain
# text here). NEVER add an OAUTH2_PROXY_CLIENT_SECRET= or
# OAUTH2_PROXY_COOKIE_SECRET= line to .env, even temporarily: if either
# variable exists in .env, oauth2-proxy gives it priority over the
# matching Docker secret (see docker-compose.yml, env_file: .env on
# oauth2-proxy) and fails at startup with an error that looks like it
# comes from nowhere (`cookie_secret must be 16, 24, or 32 bytes... but
# is 51 bytes` — 51 being the length of a placeholder string, not a real
# secret). Hit twice in the lab on this project — see the deployment
# guide.
