# Copy to ".env" and fill in after creating the client in Keycloak.

APP_DOMAIN=anonymiseur.lab.local

OAUTH2_PROXY_CLIENT_ID=anonymiseur-app
OAUTH2_PROXY_CLIENT_SECRET=<recupere-dans-keycloak-apres-creation-du-client>
# openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=<generer-une-cle-aleatoire>
