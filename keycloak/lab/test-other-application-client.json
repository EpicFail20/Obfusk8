{
  "clientId": "obfusk8-test-autre-application",
  "name": "TEST FIXTURE (LAB ONLY): another application of the same issuer",
  "description": "Issues valid lab tokens whose audience is NOT obfusk8-api, to prove that the server refuses them (D-057, benchmarks/e2e/e2e_extension_oidc.py). Accepted by nothing.",
  "protocol": "openid-connect",
  "enabled": true,
  "publicClient": true,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "consentRequired": false,
  "fullScopeAllowed": false,
  "redirectUris": ["https://glaimpfdmfkidcgalcblojmkomplcgpa.chromiumapp.org/autre-application"],
  "webOrigins": [],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "use.refresh.tokens": "false",
    "access.token.lifespan": "300"
  },
  "defaultClientScopes": ["basic", "email", "groups"],
  "optionalClientScopes": [],
  "protocolMappers": [
    {
      "name": "audience-autre-application",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {
        "included.custom.audience": "autre-application",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "introspection.token.claim": "true"
      }
    }
  ]
}
